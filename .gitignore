*.webm
*.gif
*.png
*.jpg
*.jpeg
!docs/assets/*.png
!docs/assets/*.jpg
!docs/assets/*.gif
!web/assets/*.png

# ─── Private persona packs (only `example` is versioned) ──────────────────
packs/*
!packs/example/
!packs/example/**

# ─── Training datasets ────────────────────────────────────────────────────
clips/
dataset/
sheets/

# ─── Dépendances & builds ─────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
.vercel/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
*.tsbuildinfo

# ─── Artefacts de build ───────────────────────────────────────────────────
web/dynamic_video_generator_app.html

# ─── Artefacts de refonte / temporaires ───────────────────────────────────

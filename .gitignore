*.bak-*
*.orig
*.rej
*.log
/tmp/

# ─── macOS / IDE ──────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# Images persisted by the proxy: host output, never versioned
src/dynamic_video_generator/dt_images/

# Demo renders are committed on purpose (see docs/demo/README.md); the wider
# outputs rule above would otherwise sweep them up.
!docs/demo/
!docs/demo/*.mp4
!docs/demo/*.mov
!docs/demo/*.webm
!docs/demo/*.jpg
!docs/demo/*.png
!docs/demo/*.json

# ─── The community platform is a separate project, kept out of this repo ───
community/
docs/COMMUNITY_SPEC.md

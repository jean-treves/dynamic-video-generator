# ─── Copy to .env (never versioned) ───────────────────────────────────────
# Everything below is optional: with no .env, the proxy starts locally on
# 127.0.0.1:8200 and tunnel discovery stays off.

# --- Video render backend (LTX-Video on the render machine) ---
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=8198

# --- Local prompt-orchestration LLM ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_MODEL_LITE=gemma3:1b
OLLAMA_KEEP_ALIVE=0

# --- Image generation (Draw Things) ---
DRAWTHINGS_PORT=7860
# Extra folders to list in the Images tab, colon-separated. Empty by default,
# and deliberately so: the proxy is reachable over a public tunnel, and Draw
# Things' sandbox maps its container onto your own ~/Pictures — so nothing in
# a home directory is read unless you name it here.
# DRAWTHINGS_IMAGE_ROOTS=/Users/me/Pictures/renders:/Volumes/work/out

# --- Style pack (a directory under packs/, or PHOS_PACKS_DIR) ---
# Empty = bare engine: only the generic routes are exposed.
# The PHOS_ prefix is legacy and kept on purpose, see the README.
PHOS_PACK=example
# PHOS_PACKS_DIR=/path/to/my/packs

# --- Tunnel directory -------------------------------------------------------
# Realtime DB publishing the ephemeral Cloudflare tunnel URL, read back by the
# client on load. Empty = no automatic discovery, endpoint entered by hand.
FIREBASE_DB=

# --- Reserved ngrok domain, if you own one. Empty = random URL. ---
NGROK_DOMAIN=

# --- Spoken language of generated dialogue ---
# The visual half of a prompt stays English (LTX reads English); this is only
# the language the characters speak on the /dialogue and /storyboard routes.
DIALOGUE_LANG=French

# --- Replay mode: no render backend and no LLM required ---
PHOS_MOCK=0

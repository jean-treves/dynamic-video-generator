      "variant": "emphasis"
    },
    {
      "id": "tunnel-to-proxy",
      "from": "tunnel",
      "to": "proxy",
      "label": "public entry",
      "variant": "security"
    },
    {
      "id": "tunnel-publishes",
      "from": "tunnel",
      "to": "firebase",
      "label": "publishes its URL",
      "variant": "dashed"
    },
    {
      "id": "browser-discovers",
      "from": "browser",
      "to": "firebase",
      "label": "reads it back",
      "variant": "dashed"
    },
    {
      "id": "proxy-loads-packs",
      "from": "proxy",
      "to": "packs",
      "label": "loaded at runtime",
      "variant": "dashed",
      "labelDx": -50
    },
    {
      "id": "proxy-to-ltx",
      "from": "proxy",
      "to": "ltx",
      "label": "/queue/add · /status",
      "fromSide": "top",
      "toSide": "left"
    },
    {
      "id": "proxy-to-drawthings",
      "from": "proxy",
      "to": "drawthings",
      "label": "/dt · txt2img"
    },
    {
      "id": "proxy-to-ollama",
      "from": "proxy",
      "to": "ollama",
      "label": "9 rewrite routes",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "id": "proxy-falls-back",
      "from": "proxy",
      "to": "demo",
      "label": "fallback when LTX is down",
      "variant": "dashed",
      "labelDy": 100
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "One origin",
      "items": [
        "The browser only ever talks to the proxy on :8200",
        "LTX, Draw Things and Ollama never leave 127.0.0.1"
      ]
    },
    {
      "dot": "emerald",
      "title": "Three engines, one contract",
      "items": [
        "LTX-Video renders through /queue/add and reports on /status",
        "Draw Things sits behind /dt; Ollama rewrites prompts on nine routes"
      ]
    },
    {
      "dot": "amber",
      "title": "When the render machine is gone",
      "items": [
        "/outputs falls back to the LTX renders committed in docs/demo/",
        "dvg --mock replays recorded responses end to end"
      ]
    }
  ]
}

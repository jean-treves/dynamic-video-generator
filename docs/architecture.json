{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Dynamic Video Generator",
    "locale": "en",
    "output": "architecture.html",
    "quality_profile": "showcase",
    "viewBox": [
      1180,
      640
    ],
    "views": [
      {
        "id": "one-origin",
        "label": "One origin",
        "focus": [
          "browser",
          "proxy",
          "ltx",
          "drawthings",
          "ollama"
        ],
        "note": "The browser reaches a single origin; the three engines stay on loopback behind it."
      },
      {
        "id": "backend-gone",
        "label": "Render machine gone",
        "focus": [
          "proxy",
          "ltx",
          "demo"
        ],
        "note": "With LTX unreachable the proxy answers from the renders committed in the repository."
      },
      {
        "id": "discovery",
        "label": "Tunnel discovery",
        "focus": [
          "browser",
          "tunnel",
          "firebase",
          "proxy"
        ],
        "note": "The tunnel publishes its URL; the client reads it back instead of being configured by hand."
      }
    ]
  },
